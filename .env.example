# Copy to .env and fill in. Compose overrides DATABASE_URL to point at the db service.
DATABASE_URL=postgresql://labor:labor@localhost:5432/labor

# Notion (ticket system of record). Read-mostly integration token.
NOTION_TOKEN=
NOTION_TICKET_DB_ID=35281b4e-061b-81c3-af8a-000bf14667ba
NOTION_CLIENTS_DB_ID=35681b4e-061b-80e5-b343-000b87756985

# Notion WRITE-BACK master switch. false (default) = nothing is ever written to
# Notion; status nudges + active-hours rollups queue locally in notion_outbox.
# Before setting true: create the "Active Hours" number property on the ticket DB.
NOTION_WRITE_ENABLED=false
NOTION_ACTIVE_HOURS_PROP=Active Hours

# Slack (/on toggle + blocked-by prompt). Leave SLACK_SIGNING_SECRET blank in dev
# to skip signature verification.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# Shared-secret token for the Notion "Toggle work" button webhook
# (POST /notion/button/<token>). Blank = dev mode, check skipped.
BUTTON_WEBHOOK_TOKEN=

# Worker cadence (defaults shown)
SYNC_INTERVAL_SECONDS=120
AUTOCLOSER_INTERVAL_SECONDS=600
CONVERSATIONS_INTERVAL_SECONDS=3600
IDLE_TIMEOUT_SECONDS=7200
JAKARTA_EOD_HOUR=20
MICROVIEW_SAMPLE_RATE=5
